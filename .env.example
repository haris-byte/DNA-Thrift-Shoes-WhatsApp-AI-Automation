# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_PATH=data/dna_thrift.db
MAX_CLARIFICATION_ATTEMPTS=2
MAX_IMAGE_BYTES=8000000
REQUEST_TIMEOUT_SECONDS=30

# OpenRouter — required for real brand/model/condition recognition from photos.
# Create a key in your OpenRouter account. Never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# openrouter/free can route to a free model that supports image input + structured output.
# For a stable final demo, pin a specific vision-capable model available in your account.
VISION_MODEL=openrouter/free
NLP_MODEL=openrouter/free
ENABLE_LLM_NLP=true
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=DNA Thrift WhatsApp AI

# EasyOCR
ENABLE_EASYOCR=true
EASYOCR_GPU=false

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
